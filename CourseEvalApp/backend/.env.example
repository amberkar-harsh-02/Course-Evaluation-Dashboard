# Postgres in production. Leave empty to use a local SQLite file (courseeval_dev.db) for development.
DATABASE_URL=postgresql+psycopg2://courseeval:change-me@localhost:5432/courseeval

# Required. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Required to let professors save their own OpenAI key. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it safe and never change it: stored keys can only be read with this exact value.
KEY_ENCRYPTION_SECRET=

# Credits (defaults shown)
# DEFAULT_YEARLY_CAP_USD=20          # yearly AI budget for each new professor on the lab key
# TOTAL_CREDIT_BUDGET_USD=0          # total lab budget for all professors (0 = no overall limit)
# CREDIT_YEAR_START=01-01            # MM-DD the credit year resets

# Optional (defaults shown)
# ACCESS_TOKEN_MINUTES=120
# MAX_FAILED_LOGINS=5
# LOCKOUT_MINUTES=15
# API_HOST=127.0.0.1
# API_PORT=8010
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
