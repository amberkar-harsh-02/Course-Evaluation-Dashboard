# Only needed for model_choice=openai. Local Ollama needs no key.
OPENAI_API_KEY=

# Optional overrides (defaults shown). See settings.py for the full list.
# OLLAMA_URL=http://10.9.144.10:8001/api/generate
# OLLAMA_MODEL=qwen35b:latest
# OPENAI_MODEL=gpt-5.6-terra
# OpenAI prices per 1M tokens, used for cost estimates (check openai.com/api/pricing)
# OPENAI_PRICE_INPUT_PER_M=2.00
# OPENAI_PRICE_CACHED_INPUT_PER_M=0.20
# OPENAI_PRICE_OUTPUT_PER_M=12.00
# OCR_URL=http://127.0.0.1:8000/api/extract-text
# PIPELINE_MODE=single            # or two_step (older 2-call flow)
# CONFIDENCE_GATE=on              # or off
# MAX_PARALLEL_API_CALLS=8
# MAX_PARALLEL_LOCAL_CALLS=2
# LLM_CACHE=on
# API_HOST=127.0.0.1              # use 0.0.0.0 only if other machines must reach the API
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# NLP_API_KEY=                    # when set, requests must send header X-API-Key
